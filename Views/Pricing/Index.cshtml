@{
    ViewData["Title"] = "التسعير الهندسي";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold text-primary">
            خدمات التسعير الهندسي
        </h1>

        <p class="lead">
            حلول متكاملة لإعداد الأسعار والتكاليف وتحليل البنود
        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h1>📋</h1>

                    <h4>إعداد BOQ</h4>

                    <p>
                        إعداد جداول الكميات للمشروعات المختلفة.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h1>💰</h1>

                    <h4>Rate Analysis</h4>

                    <p>
                        تحليل أسعار البنود ومكونات التكلفة.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h1>📊</h1>

                    <h4>Cost Estimation</h4>

                    <p>
                        إعداد التقديرات التكاليفية للمشروعات.
                    </p>

                </div>

            </div>

        </div>

    </div>

    <div class="row g-4 mt-4">

        <div class="col-md-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h1>📈</h1>

                    <h4>فروق الأسعار</h4>

                    <p>
                        حساب وتحليل فروق الأسعار والتعويضات.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h1>🧾</h1>

                    <h4>المستخلصات</h4>

                    <p>
                        إعداد مستخلصات المقاولين والمالكين.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h1>🏗️</h1>

                    <h4>مراجعة العطاءات</h4>

                    <p>
                        مراجعة العروض والأسعار قبل التقديم.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>