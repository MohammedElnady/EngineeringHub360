@model IEnumerable<EngineeringHub360.Models.Course>

@{
    ViewData["Title"] = "الأكاديمية";
}

<div class="container py-5">

    <h1 class="text-center mb-4">
        الأكاديمية الهندسية
    </h1>

    <div class="row">

        @foreach (var course in Model)
        {
            <div class="col-md-6 mb-3">

                <div class="card">

                    <div class="card-body">

                        <h4>@course.Title</h4>

                        <p>@course.ShortDescription</p>

                        <p>
                            السعر الحالي:
                            <strong>
                                @course.DiscountPrice ج
                            </strong>
                        </p>

                        <p>
                            السعر قبل الخصم:
                            <del>
                                @course.OriginalPrice ج
                            </del>
                        </p>

                        <p>
                            التصنيف:
                            @course.Category
                        </p>

                        <p>
                            المدرب:
                            @course.InstructorName
                        </p>

                    </div>

                </div>

            </div>
        }

    </div>

</div>